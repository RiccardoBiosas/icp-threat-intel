# Copy to .env and fill in. Secrets come from the environment only; never commit .env.

# Database (Postgres 16 + pgvector). Alembic's env.py reads this too.
ICP_THREAT_INTEL_DATABASE_URL=postgresql+psycopg://icp_threat_intel:change-me@localhost:5432/icp_threat_intel
# Password used by docker-compose for the bundled Postgres; must match the URL above.
POSTGRES_PASSWORD=change-me

# Contact address sent in the User-Agent. Live collection refuses to start without it.
ICP_THREAT_INTEL_CONTACT=

# Logging: DEBUG, INFO, WARNING, ERROR.
ICP_THREAT_INTEL_LOG_LEVEL=INFO

# Census ceiling: maximum canisters recorded per census run.
ICP_THREAT_INTEL_CENSUS_MAX_CANISTERS=50000

# Set to 1 only by `make record` to re-record cassettes against allowlisted live hosts.
ICP_THREAT_INTEL_RECORD=0

# Webhook notifier target; leave empty to use stdout only.
ICP_THREAT_INTEL_WEBHOOK_URL=

# GitHub code search is off by default (SPEC D3).
ICP_THREAT_INTEL_GITHUB_CODE_SEARCH=false

# Optional API keys (SPEC D3); each collector is disabled when its key is absent.
ABUSECH_AUTH_KEY=
GITHUB_TOKEN=
